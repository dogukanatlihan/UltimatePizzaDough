{
  // Static-asset-only Worker: no server code, so no "main" field.
  // Serves the Vite build output in ./dist from Cloudflare's edge.
  "name": "makebetter-pizza",
  "compatibility_date": "2026-07-27",
  // workers.dev preview addresses for branch builds. Cloudflare adds "X-Robots-Tag: noindex" to them,
  // so search engines do not index a second copy of the site.
  "preview_urls": true,
  // Custom domains. Cloudflare manages the DNS records and the certificates.
  "routes": [
    {
      "pattern": "makebetter.pizza",
      "custom_domain": true
    },
    {
      "pattern": "www.makebetter.pizza",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html (SPA fallback).
    "not_found_handling": "single-page-application"
  }
}
